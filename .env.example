# Необязательно. Без ключа работает явно обозначенный условный расчёт.
# Ключ VITE_* виден в браузере. Используйте отдельный ключ для демо.
VITE_ORS_API_KEY=
# Для публичного API; можно заменить совместимым прокси, если он понадобится.
VITE_ORS_BASE_URL=https://api.heigit.org
# Карта доставки и обратное геокодирование. Для большого трафика нужен свой провайдер.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_PHOTON_BASE_URL=https://photon.komoot.io
